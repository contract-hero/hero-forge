// The strict type-check of the helper CLI. The root tsconfig.json covers the
// plugin hooks with no Node types, so the scripts have their own config on
// top of it, with Node's types.
//
// Run it with scripts/typecheck.sh from the repo root. The repo has no
// dependencies, so the script brings TypeScript and @types/node from a temp
// prefix outside it.
{
  "extends": "../../../../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts"]
}
