// The strict type-check of the helper CLI. The root tsconfig.json keeps the
// shape of the plugin layer that can go back upstream (ADR 0004), so the
// scripts have their own config on top of it, with Node's types.
//
// The repo has no dependencies, so bring TypeScript and @types/node from
// outside it (Node 22 types: the oldest Node the CLI supports):
//   npm i --prefix /tmp/rp-tsc typescript@5 @types/node@22
//   /tmp/rp-tsc/node_modules/.bin/tsc -p skills/engineering/review-pipeline/scripts \
//     --noEmit --typeRoots /tmp/rp-tsc/node_modules/@types
{
  "extends": "../../../../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts"]
}
