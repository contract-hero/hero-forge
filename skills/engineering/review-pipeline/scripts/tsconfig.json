// The strict type-check of the helper CLI. The root tsconfig.json keeps the
// shape of the plugin layer that can go back upstream (ADR 0004), so the
// scripts have their own config on top of it, with Node's types.
//
// Run it with scripts/typecheck.sh from the repo root. The repo has no
// dependencies, so the script brings TypeScript and @types/node from a temp
// prefix outside it.
{
  "extends": "../../../../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts"]
}
